---
import Layout from '../layouts/Layout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import { calculators, categories } from '../data/calculators.js';
import { absoluteSiteUrl } from '../data/site.js';

const description = 'Accurate, fast online calculators for finance, health, math, dates, education, and everyday life.';
const homeUrl = absoluteSiteUrl(import.meta.env.BASE_URL);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'ClearCalc Tools', url: homeUrl, description },
    {
      '@type': 'ItemList',
      name: 'ClearCalc calculators',
      itemListElement: calculators.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.title,
        url: absoluteSiteUrl(`/calculators/${item.slug}/`)
      }))
    }
  ]
};
const jsonLd = JSON.stringify(schema).replaceAll('<', '\\u003c');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const categoryNotes = {
  Finance: [
    ['mortgage-calculator', 'Mortgage payment'],
    ['mortgage-payoff-calculator', 'Mortgage payoff'],
    ['amortization-calculator', 'Amortization'],
    ['investment-calculator', 'Investment'],
    ['retirement-calculator', 'Retirement'],
    ['roth-ira-calculator', 'Roth IRA'],
    ['cd-calculator', 'CD'],
    ['rent-vs-buy-calculator', 'Rent vs buy'],
    ['uk-mortgage-calculator', 'UK mortgage'],
    ['canada-mortgage-calculator', 'Canada mortgage'],
    ['england-stamp-duty-calculator', 'England stamp duty']
  ],
  Health: [
    ['bmi-calculator', 'BMI'],
    ['bmr-calculator', 'BMR'],
    ['tdee-calculator', 'TDEE'],
    ['calorie-calculator', 'Calories'],
    ['pace-calculator', 'Running pace'],
    ['5k-pace-calculator', '5K pace'],
    ['period-calculator', 'Period'],
    ['ovulation-calculator', 'Ovulation'],
    ['pregnancy-due-date-calculator', 'Due date']
  ],
  Math: [
    ['percentage-calculator', 'Percentage'],
    ['percentage-change-calculator', 'Percent increase'],
    ['fraction-calculator', 'Fractions'],
    ['ratio-calculator', 'Ratios'],
    ['area-calculator', 'Area'],
    ['random-number-generator', 'Random numbers']
  ],
  Education: [
    ['grade-calculator', 'Weighted grade'],
    ['gpa-calculator', 'GPA'],
    ['final-exam-grade-calculator', 'Final exam']
  ],
  Everyday: [
    ['tip-calculator', 'Tip'],
    ['discount-calculator', 'Discount'],
    ['electricity-cost-calculator', 'Electricity cost'],
    ['fuel-cost-calculator', 'Fuel cost'],
    ['sales-tax-calculator', 'Sales tax']
  ],
  'Date & Time': [
    ['age-calculator', 'Age'],
    ['date-difference-calculator', 'Date difference'],
    ['add-days-calculator', 'Add days'],
    ['time-card-hours-calculator', 'Time card']
  ],
  Conversions: [
    ['length-converter', 'Length'],
    ['weight-converter', 'Weight'],
    ['fuel-economy-converter', 'Fuel economy'],
    ['celsius-to-fahrenheit-calculator', 'Celsius to Fahrenheit']
  ],
  'Work & Pay': [
    ['us-federal-income-tax-calculator', 'Federal income tax'],
    ['texas-paycheck-calculator', 'Texas paycheck'],
    ['california-paycheck-calculator', 'California paycheck'],
    ['uk-take-home-pay-calculator', 'UK take-home pay'],
    ['ontario-take-home-pay-calculator', 'Ontario take-home'],
    ['australia-take-home-pay-calculator', 'Australia take-home']
  ],
  'Home & DIY': [
    ['square-footage-calculator', 'Square footage'],
    ['concrete-slab-calculator', 'Concrete'],
    ['drywall-calculator', 'Drywall'],
    ['floor-tile-calculator', 'Floor tile']
  ]
};
---
<Layout title="Free Online Calculators | ClearCalc Tools" description={description}>
  <script type="application/ld+json" set:html={jsonLd} />
  <section class="hero"><div><span class="eyebrow">FREE • FAST • PRIVATE</span><h1>Calculate with confidence.</h1><p>Clear answers for money, health, school, and everyday decisions. No signup required.</p><a class="button" href="#calculators">Explore calculators</a> <a href={`${base}calculators/england-stamp-duty-calculator/`}>Stamp duty calculator UK</a></div><div class="hero-panel"><span>Quick calculation</span><strong>Simple inputs.</strong><strong>Clear results.</strong><strong>Useful explanations.</strong></div></section>
  <section class="trust"><span>✓ No account</span><span>✓ Mobile friendly</span><span>✓ Transparent formulas</span></section>
  <section id="calculators" class="section"><div class="section-heading"><div><span class="eyebrow">CALCULATOR LIBRARY</span><h2>Popular calculators</h2></div><p>Choose a tool and get an answer in seconds.</p></div>
    {categories.map((category) => {
      const categoryId = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const notes = categoryNotes[category] ?? [];
      return <div class="category-section" id={categoryId}><h3 class="category-title">{category}</h3>{notes.length ? <p class="category-note">{notes.map((item, index) => <>{index ? ' · ' : ''}<a href={`${base}calculators/${item[0]}/`}>{item[1]}</a></>)}</p> : null}<div class="card-grid">{calculators.filter((item) => item.category === category).map((item) => <CalculatorCard item={item} />)}</div></div>;
    })}
  </section>
  <section class="content-band"><h2>Designed to make numbers easier</h2><p>Every ClearCalc tool focuses on one job, shows the formula it uses, and runs in your browser. Nothing you type is sent to a ClearCalc account. Results are estimates. For an important money or health decision, compare the result with a qualified professional and with the lender, school, or clinician who has your actual terms.</p><p>UK tools sit together. The <a href={`${base}calculators/england-stamp-duty-calculator/`}>stamp duty calculator for England and Northern Ireland</a> estimates SDLT for a 2026 completion, including first-time buyers and additional properties, and it can switch to the 2018, 2019, holiday, and pre-2014 rate cards. A purchase in Scotland uses the <a href={`${base}calculators/scotland-lbtt-calculator/`}>Scotland LBTT calculator</a>. A purchase in Wales uses the <a href={`${base}calculators/wales-land-transaction-tax-calculator/`}>Wales land transaction tax calculator</a>. Pay in that cluster is the <a href={`${base}calculators/uk-take-home-pay-calculator/`}>2026/27 take-home pay calculator</a> for England, Wales, and Northern Ireland, the <a href={`${base}calculators/scotland-take-home-pay-calculator/`}>Scotland take-home pay calculator</a>, and the <a href={`${base}calculators/northern-ireland-take-home-pay-calculator/`}>Northern Ireland take-home pay calculator</a>. The <a href={`${base}calculators/uk-student-loan-repayment-calculator/`}>UK student loan repayment calculator</a> and the <a href={`${base}calculators/uk-working-days-calculator/`}>UK working days calculator</a> answer the questions those tax pages leave out.</p><p>The <a href={`${base}calculators/mortgage-calculator/`}>mortgage payment calculator</a> and the <a href={`${base}calculators/loan-calculator/`}>loan payment calculator</a> both use standard monthly amortization, with taxes and fees left out so the interest math stays visible. The <a href={`${base}calculators/compound-interest-calculator/`}>compound interest calculator</a> projects a balance from a starting amount and end-of-month deposits. Health tools cover <a href={`${base}calculators/bmi-calculator/`}>adult BMI</a> from kilograms and centimeters and a <a href={`${base}calculators/calorie-calculator/`}>maintenance-calorie estimate</a> from the Mifflin–St Jeor equation for men or women. Everyday math includes a <a href={`${base}calculators/percentage-calculator/`}>percentage calculator</a>, a <a href={`${base}calculators/tip-calculator/`}>tip split</a>, a <a href={`${base}calculators/discount-calculator/`}>percent-off sale price</a>, and a <a href={`${base}calculators/length-converter/`}>length converter</a> from meters to feet, inches, yards, or kilometers. Date tools count an <a href={`${base}calculators/age-calculator/`}>exact age</a> or the <a href={`${base}calculators/date-difference-calculator/`}>days between two dates</a>. Work and pay includes a <a href={`${base}calculators/uk-take-home-pay-calculator/`}>2026/27 take-home pay calculator</a> for employees in England, Wales, and Northern Ireland. The <a href={`${base}calculators/gpa-calculator/`}>GPA calculator</a> averages four unweighted grades on a 4.0 scale, and the <a href={`${base}calculators/final-exam-grade-calculator/`}>final exam grade calculator</a> solves for the score a weighted final needs. Home projects include a <a href={`${base}calculators/concrete-slab-calculator/`}>concrete slab calculator</a> that turns feet and inches into bags and cubic yards.</p><p>Five later tools answer questions the earlier pages leave open. The <a href={`${base}calculators/new-york-paycheck-calculator/`}>2026 New York paycheck calculator</a> adds New York State tax and, when you ask for it, New York City resident tax. The <a href={`${base}calculators/alberta-take-home-pay-calculator/`}>Alberta take-home pay calculator</a> uses the 2026 Alberta brackets, CPP, and EI, with no provincial health premium. The <a href={`${base}calculators/nsw-stamp-duty-calculator/`}>NSW stamp duty calculator</a> applies 2026/27 New South Wales transfer duty, including the first home buyer concession. The <a href={`${base}calculators/uk-student-loan-repayment-calculator/`}>UK student loan repayment calculator</a> estimates a 2026/27 Plan 1, Plan 2, Plan 4, Plan 5, or postgraduate deduction, which the England take-home page does not subtract. The <a href={`${base}calculators/room-paint-calculator/`}>room paint calculator</a> turns a rectangular room into gallons. The <a href={`${base}calculators/date-difference-calculator/`}>day counter</a> still includes weekends: calendar year 2026 has 261 weekdays, 52 Saturdays, and 52 Sundays, and the elapsed count from 1 January to 31 December remains 364.</p><p>Pay calculators are split by the tax system they use. The <a href={`${base}calculators/texas-paycheck-calculator/`}>Texas paycheck calculator</a> and the <a href={`${base}calculators/florida-paycheck-calculator/`}>Florida paycheck calculator</a> estimate 2026 federal income tax, Social Security, and Medicare, with a state income tax line of zero. The <a href={`${base}calculators/california-paycheck-calculator/`}>California paycheck calculator</a> adds 2026 California income tax and State Disability Insurance. The <a href={`${base}calculators/washington-paycheck-calculator/`}>Washington paycheck calculator</a> keeps state income tax at $0 and subtracts 2026 Paid Leave and WA Cares. The <a href={`${base}calculators/scotland-take-home-pay-calculator/`}>Scotland take-home pay calculator</a> uses the 2026/27 Scottish income tax bands. The <a href={`${base}calculators/ontario-take-home-pay-calculator/`}>Ontario take-home pay calculator</a> uses 2026 federal and Ontario rates, CPP, and EI. The <a href={`${base}calculators/british-columbia-take-home-pay-calculator/`}>British Columbia take-home pay calculator</a> uses the 2026 B.C. brackets, including the 5.60% first rate and the tax reduction. The <a href={`${base}calculators/australia-take-home-pay-calculator/`}>Australia take-home pay calculator</a> uses the 2026–27 resident rates, the low income tax offset, and the Medicare levy. The <a href={`${base}calculators/england-stamp-duty-calculator/`}>England stamp duty calculator</a> applies residential SDLT, including first-time buyer relief and the additional-dwelling rates. Work tools also include an <a href={`${base}calculators/hourly-to-salary-calculator/`}>hourly to salary calculator</a>, a <a href={`${base}calculators/overtime-pay-calculator/`}>weekly overtime pay calculator</a>, and a <a href={`${base}calculators/401k-contribution-calculator/`}>2026 401(k) contribution calculator</a>. The <a href={`${base}calculators/rent-affordability-calculator/`}>rent affordability calculator</a> compares rent with 30% of gross income.</p><p>Another set of tools answers a narrower question than the page beside it. The <a href={`${base}calculators/illinois-paycheck-calculator/`}>2026 Illinois paycheck calculator</a> keeps the federal brackets and then applies the 4.95% Illinois rate after a $2,925 exemption, which is a different subtraction from the New York brackets or from a state line of zero. The <a href={`${base}calculators/manitoba-take-home-pay-calculator/`}>Manitoba take-home pay calculator</a> uses the 2026 Manitoba brackets, 10.8%, 12.75%, and 17.4%, with the $15,780 basic personal amount, on top of the same federal, CPP, and EI figures as Alberta. The <a href={`${base}calculators/victoria-stamp-duty-calculator/`}>Victoria stamp duty calculator</a> applies Victorian land transfer duty, including the first home buyer concession through $750,000 and the 8% foreign purchaser additional duty. The <a href={`${base}calculators/us-business-days-calculator/`}>US business days calculator</a> counts inclusive weekdays and can remove the 11 federal holidays. For 2026 that leaves 250 business days, against 261 weekdays and against the 364 elapsed days from 1 January to 31 December on the day counter. The <a href={`${base}calculators/mulch-calculator/`}>mulch calculator</a> turns a bed measured in feet, and a depth in inches, into cubic yards and 2 or 3 cubic foot bags. A 10 by 20 foot bed at 3 inches is 25 of the 2 cubic foot bags, which is not the bag count on the concrete page.</p><p>Five more tools fill gaps those pages leave. The <a href={`${base}calculators/pennsylvania-paycheck-calculator/`}>2026 Pennsylvania paycheck calculator</a> applies the 3.07% state tax to wages before a 401(k), then a local earned income tax rate you type and a flat local services tax. At $65,000, single, with a 1% local rate and $52, the two-week headline is $1,988.85. The <a href={`${base}calculators/saskatchewan-take-home-pay-calculator/`}>Saskatchewan take-home pay calculator</a> uses the 2026 brackets, 10.5%, 12.5%, and 14.5%, and a $20,381 basic personal amount. At $70,000 the monthly headline is $4,389.11, between Alberta and Manitoba on the same federal, CPP, and EI lines. The <a href={`${base}calculators/queensland-stamp-duty-calculator/`}>Queensland stamp duty calculator</a> follows the Queensland Revenue Office scales, including $6,555 of transfer duty on a $730,000 established first home. The <a href={`${base}calculators/uk-working-days-calculator/`}>UK working days calculator</a> counts inclusive weekdays and can remove bank holidays. England and Wales have 253 working days in 2026, against 250 US business days and against 261 weekdays. The <a href={`${base}calculators/gravel-calculator/`}>gravel calculator</a> turns the same 10 by 20 foot, 3 inch area the mulch page uses into 2.625 short tons of dry gravel at 105 lb per cubic foot.</p><p>Five further tools answer a different statute or a different unit. The <a href={`${base}calculators/ohio-paycheck-calculator/`}>2026 Ohio paycheck calculator</a> follows Ohio Revised Code 5747.02: no nonbusiness tax on the first $26,050 of Ohio taxable income, then $332 plus 2.75% of the excess, after a personal exemption. At $65,000, single, with one exemption and the school district and city rates left at zero, Ohio tax is $1,344.00 and the two-week headline is $2,040.90. The <a href={`${base}calculators/nova-scotia-take-home-pay-calculator/`}>Nova Scotia take-home pay calculator</a> uses the 2026 brackets, starting at 8.79%, and a $11,932 basic personal amount. At $70,000 the monthly headline is $4,208.02, which is $2,173.04 below Saskatchewan on the same federal, CPP, and EI lines. The <a href={`${base}calculators/scotland-lbtt-calculator/`}>Scotland LBTT calculator</a> applies residential Land and Buildings Transaction Tax, including first-time buyer relief of up to £600 and the 8% additional dwelling supplement. A £250,000 main home is £2,100, against £2,500 of SDLT on the England page. The <a href={`${base}calculators/canada-business-days-calculator/`}>Canada business days calculator</a> removes statutory holidays for Ontario, British Columbia, or Alberta. Ontario has 253 business days in 2026, British Columbia 250, and Alberta 252, against 261 weekdays. The <a href={`${base}calculators/5k-pace-calculator/`}>5K pace calculator</a> turns a finish time into minutes per kilometre and per mile. A 25:00 5K is 5:00 per kilometre and 8:02.8 per mile, which is not a calorie total.</p><p>Five further tools use a different statute or a different unit from the page beside them. The <a href={`${base}calculators/michigan-paycheck-calculator/`}>2026 Michigan paycheck calculator</a> applies 4.25% after a $5,900 exemption. At $65,000, single, with one exemption and no city tax, Michigan tax is $2,511.75 and the two-week headline is $1,995.99. Ohio on the same wages is $1,344.00 of state tax and $2,040.90 every two weeks. A Detroit resident on the Michigan wage adds $1,545.60 of city tax. The <a href={`${base}calculators/new-brunswick-take-home-pay-calculator/`}>New Brunswick take-home pay calculator</a> uses the 2026 brackets, 9.40%, 14%, 16%, and 19.5%, and a $13,664 basic personal amount. At $70,000 the monthly headline is $4,336.82, which is $128.80 above Nova Scotia on the same federal, CPP, and EI lines. The <a href={`${base}calculators/wales-land-transaction-tax-calculator/`}>Wales land transaction tax calculator</a> follows the GOV.WALES residential tables. A £280,000 main home is £3,300. A £250,000 main home is £1,500, against £2,500 of SDLT and £2,100 of LBTT. The <a href={`${base}calculators/floor-tile-calculator/`}>floor tile calculator</a> counts tiles from a grout joint. A 10 by 12 foot floor with 12 inch tiles, a 1/8 inch joint, and 10% waste is 130 tiles, 13 boxes of 10. The <a href={`${base}calculators/fuel-economy-converter/`}>fuel economy converter</a> separates the US gallon from the imperial gallon. 30 US mpg is 7.84 L/100 km and 36.03 UK mpg. The same digits read as UK mpg are 9.42 L/100 km.</p><p>Five further tools use a statute or a measurement the pages above do not. The <a href={`${base}calculators/georgia-paycheck-calculator/`}>2026 Georgia paycheck calculator</a> applies the 4.99% rate in HB 463 after a $15,000 single standard deduction. At $65,000, single, with no dependents, Georgia tax is $2,495.00 and the two-week headline is $1,996.63. The <a href={`${base}calculators/north-carolina-paycheck-calculator/`}>North Carolina paycheck calculator</a> uses the 3.99% rate for taxable years after 2025 and a $12,750 standard deduction. The same wage is $2,084.78 of North Carolina tax and $2,012.41 every two weeks. The <a href={`${base}calculators/quebec-take-home-pay-calculator/`}>Quebec take-home pay calculator</a> uses QPP, QPIP, the 1.30% Quebec EI rate, and the 16.5% federal abatement. At $70,000 the monthly headline is $4,253.73, which is $83.09 below New Brunswick because the payroll system is not the same. The <a href={`${base}calculators/western-australia-stamp-duty-calculator/`}>Western Australia stamp duty calculator</a> uses the first home owner rate for an agreement entered into on or after 7 May 2026. A $650,000 home is $8,075.00, against $24,890.00 on the general rate. The <a href={`${base}calculators/square-footage-calculator/`}>square footage calculator</a> turns 12 feet 6 inches by 10 feet into 125.00 square feet. The 10 by 12 floor on the tile page is 120.00 square feet here, and 132.00 square feet after 10% extra.</p><p>Five further tools answer a payment, a price, a state, a province, or a sheet count the pages above do not. The <a href={`${base}calculators/credit-card-payoff-calculator/`}>credit card payoff calculator</a> turns a $5,000 balance at 21.99% into 34 months when the fixed payment is $200, with $1,748.71 of interest. The same balance at $150 takes 52 months and $2,795.72 of interest. The <a href={`${base}calculators/house-affordability-calculator/`}>how much house calculator</a>, on $120,000 of gross income, $400 of other monthly debts, a $60,000 down payment, 6.5% for 30 years, $3,600 of tax, and $1,800 of insurance, solves a $431,795.43 home and a $371,795.43 loan. Principal and interest on that loan is $2,350.00, the same figure the mortgage page returns for that loan. The <a href={`${base}calculators/virginia-paycheck-calculator/`}>2026 Virginia paycheck calculator</a> charges $2,923.40 of Virginia tax on $65,000 single with one $930 exemption, and the two-week headline is $1,980.16. Georgia on that wage is $2,495.00 and $1,996.63. The <a href={`${base}calculators/prince-edward-island-take-home-pay-calculator/`}>Prince Edward Island take-home pay calculator</a> uses the 2026 brackets from 9.50% through 20% and a $15,000 basic personal amount. At $70,000 the monthly headline is $4,281.99, which is $54.83 below New Brunswick and $73.97 above Nova Scotia on the same federal, CPP, and EI lines. The <a href={`${base}calculators/drywall-calculator/`}>drywall calculator</a> counts sheets. A 12 by 10 foot room with 8 foot walls, 36 square feet of openings, the ceiling, and 10% waste needs 15 of the 4 by 8 sheets. The square footage page does not count those sheets.</p><p>Five further tools cover a conversion, a retail tax, a state, a province, and a conveyance the pages above do not. The <a href={`${base}calculators/celsius-to-fahrenheit-calculator/`}>Celsius to Fahrenheit calculator</a> uses °F = °C × 9/5 + 32. 180°C is 356°F, and a chart that prints 350°F is six degrees low. 72°F is 22.22°C on the headline and 22.2222°C before that rounding. The <a href={`${base}calculators/sales-tax-calculator/`}>sales tax calculator</a> adds a rate or removes it. $100 at 8.25% is $8.25 of tax and a $108.25 total. New Jersey’s statewide rate on 1 July 2026 is 6.625%, which is $3.31 on $49.99 and a $53.30 total. The <a href={`${base}calculators/new-jersey-paycheck-calculator/`}>2026 New Jersey paycheck calculator</a> uses Table A. At $65,000 single with one $1,000 exemption, New Jersey tax is $2,043.50 and the two-week headline is $2,014.00. Virginia on that wage is $2,923.40 and $1,980.16. A traditional 401(k) does not reduce the New Jersey tax. The <a href={`${base}calculators/newfoundland-and-labrador-take-home-pay-calculator/`}>Newfoundland and Labrador take-home pay calculator</a> uses the 2026 brackets from 8.7% and a $13,094 basic personal amount, not the July withholding catch-up of $15,000. At $70,000 the monthly headline is $4,308.58, which is $26.59 above Prince Edward Island on the same federal, CPP, and EI lines. The <a href={`${base}calculators/south-australia-stamp-duty-calculator/`}>South Australia stamp duty calculator</a> charges $26,830.00 on a $600,000 home. An eligible first buyer of a new home pays $0.00, with no price cap. A foreign person adds 7%, and the $600,000 headline becomes $68,830.00. Western Australia’s first home at $650,000 is $8,075.00, not this scale.</p><p>Five further tools answer a ratio, a height formula, a state, a territory, and a conveyance the pages above do not. The <a href={`${base}calculators/debt-to-income-ratio-calculator/`}>debt-to-income ratio calculator</a> keeps housing apart from other debts. On $8,000 of gross monthly income, a $2,200 housing payment and $400 of other debts is 27.50% front-end and 32.50% back-end. The how-much-house sample, $2,800 of housing on $10,000 a month plus $400 of other debts, is 28.00% and 32.00% here. The <a href={`${base}calculators/ideal-weight-calculator/`}>ideal weight calculator</a> uses Devine, Robinson, and Miller. A man at 175 cm has a Devine headline of 70.5 kg, which is 70.46 kg before rounding. The BMI page, given 70.5 kg and 175 cm, shows BMI 23. That ratio is not Devine. The <a href={`${base}calculators/arizona-paycheck-calculator/`}>2026 Arizona paycheck calculator</a> applies a flat 2.5% after a $15,750 standard deduction. At $65,000 single, Arizona tax is $1,231.25 and the two-week headline is $2,045.24. New Jersey on that wage is $2,043.50 and $2,014.00, and a 401(k) reduces Arizona tax only. The <a href={`${base}calculators/tasmania-stamp-duty-calculator/`}>Tasmania stamp duty calculator</a> charges $20,372.50 on a $550,000 home. An eligible first buyer of an established home pays $0.00 only if the transfer settles on or before 30 June 2026 and the value is at or under $750,000. A foreign person adds 8%, and the $550,000 headline becomes $64,372.50. South Australia’s general duty at $600,000 is $26,830.00, against $22,497.50 on this Tasmanian scale. The <a href={`${base}calculators/northwest-territories-take-home-pay-calculator/`}>Northwest Territories take-home pay calculator</a> uses the 2026 brackets from 5.9% to 14.05% and an $18,198 basic personal amount. At $70,000 the monthly headline is $4,537.04, which is $228.46 above Newfoundland and Labrador on the same federal, CPP, and EI lines, because territorial tax is $3,197.57 rather than $5,938.98.</p><p>Five further tools cover a due date, simple interest, two state paychecks, and a territory conveyance the pages above do not. The <a href={`${base}calculators/pregnancy-due-date-calculator/`}>pregnancy due date calculator</a> uses Naegele’s rule. A last menstrual period of 1 January 2026 and a 28-day cycle is due 8 October 2026, and gestational age on 1 April 2026 is 12 weeks and 6 days. A 35-day cycle moves the due date to 15 October 2026 and leaves that week count unchanged. The <a href={`${base}calculators/simple-interest-calculator/`}>simple interest calculator</a> multiplies principal, rate, and time. $10,000 at 5% for 3 years is $1,500.00 of interest and an $11,500.00 total. The compound interest page, with no monthly deposit, turns the same inputs into $11,614.72. The <a href={`${base}calculators/colorado-paycheck-calculator/`}>2026 Colorado paycheck calculator</a> applies a flat 4.40% to federal taxable income. At $65,000 single, Colorado tax is $2,151.60 and the two-week headline is $2,009.84. Arizona on that wage is $1,231.25 and $2,045.24. The <a href={`${base}calculators/massachusetts-paycheck-calculator/`}>2026 Massachusetts paycheck calculator</a> charges 5% after a $4,400 exemption. The same wage is $3,030.00 of state tax and $1,976.06 every two weeks. A 4% surtax applies only above $1,107,750 of taxable income. The <a href={`${base}calculators/act-stamp-duty-calculator/`}>ACT stamp duty calculator</a> uses the 2026–27 conveyance scales. An $800,000 owner-occupier pays $22,158.00, an investor pays $25,150.00, and an eligible home buyer with a contract on or after 1 July 2026 pays $0.00. Tasmania’s general duty at $550,000 is $20,372.50, on a different statute.</p><p>Ten further tools answer a payment, a ratio, a conversion, two states, a territory, a conveyance, a wall, and a shift. The <a href={`${base}calculators/car-payment-calculator/`}>car payment calculator</a> takes the term in months. $25,000 at 6% for 60 months is $483.32 a month and $3,999.20 of interest. The <a href={`${base}calculators/roi-calculator/`}>ROI calculator</a> divides profit by cost. A $10,000 cost that ends at $12,500 is 25.00% and $2,500.00 of profit. A zero cost is rejected. The <a href={`${base}calculators/percentage-change-calculator/`}>percentage change calculator</a> uses (new − old) / old. From 80 to 100 is a 25.00% increase. From 100 to 80 is a −20.00% decrease. The <a href={`${base}calculators/fahrenheit-to-celsius-calculator/`}>Fahrenheit to Celsius calculator</a> uses °C = (°F − 32) × 5/9. 32°F is 0°C, 98.6°F is 37°C, and 72°F is 22.22°C. The Celsius page still owns 180°C = 356°F.</p><p>The <a href={`${base}calculators/oregon-paycheck-calculator/`}>2026 Oregon paycheck calculator</a> applies the OR-ESTIMATE brackets after a $2,910 single deduction and does not subtract federal tax. At $65,000 single, Oregon tax is $5,113.38 and the two-week headline is $1,895.93. The <a href={`${base}calculators/minnesota-paycheck-calculator/`}>Minnesota paycheck calculator</a> uses a $15,300 deduction and the 5.35% to 9.85% brackets. The same wage is $2,896.61 of Minnesota tax and $1,981.19 every two weeks. The <a href={`${base}calculators/yukon-take-home-pay-calculator/`}>Yukon take-home pay calculator</a> uses 6.4% to 15% and the shared federal, CPP, and EI helper. At $70,000 the monthly headline is $4,521.58, against $4,537.04 in the Northwest Territories. The <a href={`${base}calculators/northern-territory-stamp-duty-calculator/`}>Northern Territory stamp duty calculator</a> follows Schedule 1. A $500,000 purchase is $23,928.60. A $750,000 purchase is $37,125.00. There is no first-home duty exemption. The <a href={`${base}calculators/wallpaper-calculator/`}>wallpaper calculator</a> turns a 12 by 10 by 8 foot room, 36 square feet of openings, 10% waste, and a 56 square foot roll into 7 rolls. The <a href={`${base}calculators/time-card-hours-calculator/`}>time card hours calculator</a> turns 09:00 to 17:30 with a 30-minute break into 8.0000 hours, or 8:00. It does not roll a night shift into the next day.</p><p>Ten further tools cover a price index, a circumference, a cycle, a bedtime, three wage taxes, a territory, a UK nation, and a fence. The <a href={`${base}calculators/inflation-calculator/`}>inflation calculator</a> uses CPI-U annual averages. $100 in 2016 is $134.14 in 2025, a 34.14% rise. A constant 3% for 10 years is a different path and prices the same $100 at $134.39. The <a href={`${base}calculators/body-fat-calculator/`}>body fat calculator</a> uses the U.S. Navy equations. A man at 70 inches, neck 15, waist 34, and 180 pounds is 17.51% body fat. The <a href={`${base}calculators/ovulation-calculator/`}>ovulation calculator</a> counts from the last period. A 1 January 2026 period, a 28-day cycle, and a 14-day luteal phase ovulates on 15 January 2026. The <a href={`${base}calculators/sleep-calculator/`}>sleep calculator</a> uses 90-minute cycles. Waking at 06:30, with 15 minutes to fall asleep, puts the 5-cycle bedtime at 22:45 the evening before.</p><p>The <a href={`${base}calculators/tennessee-paycheck-calculator/`}>2026 Tennessee paycheck calculator</a> has no wage tax. At $65,000 single the two-week headline is $2,092.60, the same federal and FICA result as Texas, with the Hall tax repeal stated on the page. The <a href={`${base}calculators/indiana-paycheck-calculator/`}>Indiana paycheck calculator</a> applies 2.95% after a $1,000 exemption and a county rate you type. At $65,000 single, one exemption, and 2.02% county tax, state tax is $1,888.00, county tax is $1,292.80, and the two-week headline is $1,970.26. The <a href={`${base}calculators/maryland-paycheck-calculator/`}>Maryland paycheck calculator</a> uses the state brackets, a local rate, and an indexed standard deduction of $3,400 single. At $65,000 single, one exemption, and 3.20% local tax, state tax is $2,721.50, local tax is $1,868.80, and the two-week headline is $1,916.05. The <a href={`${base}calculators/nunavut-take-home-pay-calculator/`}>Nunavut take-home pay calculator</a> uses 4% to 11.5% and a $19,659 basic personal amount. At $70,000 the monthly headline is $4,618.79, against $4,537.04 in the Northwest Territories. The <a href={`${base}calculators/northern-ireland-take-home-pay-calculator/`}>Northern Ireland take-home pay calculator</a> uses rest-of-UK bands and UK National Insurance. At £35,000 with no loan the monthly figure is £2,393.30. Plan 1 subtracts £729.00 and the headline becomes £2,332.55. The <a href={`${base}calculators/fence-calculator/`}>fence calculator</a> counts a 40 by 20 foot rectangle at 8 foot spacing as 16 posts, 32 rails, and 241 pickets.</p><p>Ten further tools answer a tax, a price, a date, or a unit the pages above leave open. The <a href={`${base}calculators/uk-vat-calculator/`}>UK VAT calculator</a> adds or removes 20%, 5%, or 0%. £100 at 20% is £120.00. The <a href={`${base}calculators/savings-goal-calculator/`}>savings goal calculator</a> turns a $25,000 target, $5,000 already saved, and 5% for 5 years into a $273.26 monthly deposit. The <a href={`${base}calculators/apr-calculator/`}>APR calculator</a> puts a 7% note and a $300 prepaid charge on a $10,000, 36-month loan at 9.069% APR. The <a href={`${base}calculators/us-federal-income-tax-calculator/`}>2026 federal income tax calculator</a> splits $80,000 single into $8,770.00 of tax after the $16,100 standard deduction. The <a href={`${base}calculators/canada-gst-hst-calculator/`}>Canada GST/HST calculator</a> uses the CRA rates, including Ontario at 13% and Nova Scotia at 14% from 1 April 2025. The <a href={`${base}calculators/weight-converter/`}>weight converter</a> turns 70 kg into 154.32 lb. The <a href={`${base}calculators/add-days-calculator/`}>add-days calculator</a> moves 1 January 2026 forward 90 days to 1 April 2026. The <a href={`${base}calculators/markup-margin-calculator/`}>markup and margin calculator</a> shows that a 50% markup on a $40 cost is a $60 price and a 33.33% margin. The <a href={`${base}calculators/down-payment-calculator/`}>down payment calculator</a> turns 20% of $400,000 into $80,000 down and a $320,000 loan. The <a href={`${base}calculators/australia-gst-calculator/`}>Australia GST calculator</a> removes 10% from $110 and returns $100.00 before GST.</p><p>A further set of tools answers a projection, a schedule, or a measurement the pages above leave open. The <a href={`${base}calculators/investment-calculator/`}>investment calculator</a> projects $10,000 plus $250 a month at 7% to $63,367.82 in 10 years. The <a href={`${base}calculators/retirement-calculator/`}>retirement calculator</a> restates a nest egg in today’s dollars. The <a href={`${base}calculators/roth-ira-calculator/`}>Roth IRA calculator</a> uses the 2026 IRS limit of $7,500, or $8,600 at age 50 or older. The <a href={`${base}calculators/cd-calculator/`}>CD calculator</a> turns a 5% APR compounded monthly into a $10,511.62 maturity on $10,000. The <a href={`${base}calculators/mortgage-payoff-calculator/`}>mortgage payoff calculator</a> and the <a href={`${base}calculators/amortization-calculator/`}>amortization calculator</a> sit next to the mortgage payment. The <a href={`${base}calculators/rent-vs-buy-calculator/`}>rent versus buy calculator</a>, the <a href={`${base}calculators/uk-mortgage-calculator/`}>UK mortgage calculator</a>, and the <a href={`${base}calculators/canada-mortgage-calculator/`}>Canada mortgage calculator</a> cover the comparisons those payment pages do not. Math tools add a <a href={`${base}calculators/fraction-calculator/`}>fraction calculator</a>, a <a href={`${base}calculators/ratio-calculator/`}>ratio calculator</a>, an <a href={`${base}calculators/area-calculator/`}>area calculator</a>, and a <a href={`${base}calculators/random-number-generator/`}>random number generator</a>. The <a href={`${base}calculators/grade-calculator/`}>grade calculator</a> is a weighted average, separate from GPA and the final-exam score. Health tools add <a href={`${base}calculators/bmr-calculator/`}>BMR</a>, <a href={`${base}calculators/tdee-calculator/`}>TDEE</a>, a <a href={`${base}calculators/period-calculator/`}>period calculator</a>, and a <a href={`${base}calculators/pace-calculator/`}>pace calculator</a> for any distance. Everyday costs add an <a href={`${base}calculators/electricity-cost-calculator/`}>electricity cost calculator</a> and a <a href={`${base}calculators/fuel-cost-calculator/`}>fuel cost calculator</a>.</p><p>Each cluster has its own page. <a href={`${base}topics/paychecks-and-wages/`}>Paychecks and wages</a>, <a href={`${base}topics/uk-canada-australia-tax/`}>UK, Canada, and Australia tax</a>, <a href={`${base}topics/mortgages-and-money/`}>mortgages and money</a>, <a href={`${base}topics/retirement-and-investing/`}>retirement and investing</a>, <a href={`${base}topics/health-and-fitness/`}>health and fitness</a>, <a href={`${base}topics/dates-and-time/`}>dates and time</a>, <a href={`${base}topics/conversions/`}>conversions</a>, <a href={`${base}topics/math-and-school/`}>math and school</a>, <a href={`${base}topics/home-improvement/`}>home improvement</a>, and <a href={`${base}topics/everyday-costs/`}>everyday costs</a> list every calculator in that group.</p><p>New tools in that set include an <a href={`${base}calculators/ontario-land-transfer-tax-calculator/`}>Ontario land transfer tax calculator</a>, a <a href={`${base}calculators/british-columbia-property-transfer-tax-calculator/`}>British Columbia property transfer tax calculator</a>, a <a href={`${base}calculators/uk-capital-gains-tax-calculator/`}>UK capital gains tax calculator</a>, a <a href={`${base}calculators/uk-dividend-tax-calculator/`}>UK dividend tax calculator</a>, a <a href={`${base}calculators/uk-national-insurance-calculator/`}>UK National Insurance calculator</a>, an <a href={`${base}calculators/australia-superannuation-guarantee-calculator/`}>Australia superannuation guarantee calculator</a>, a <a href={`${base}calculators/canada-rrsp-tax-savings-calculator/`}>Canada RRSP tax savings calculator</a>, an <a href={`${base}calculators/irs-rmd-calculator/`}>IRS RMD calculator</a>, a <a href={`${base}calculators/mortgage-refinance-calculator/`}>mortgage refinance calculator</a>, a <a href={`${base}calculators/student-loan-repayment-calculator/`}>student loan repayment calculator</a>, a <a href={`${base}calculators/home-equity-loan-calculator/`}>home equity loan calculator</a>, a <a href={`${base}calculators/net-worth-calculator/`}>net worth calculator</a>, a <a href={`${base}calculators/50-30-20-budget-calculator/`}>50/30/20 budget calculator</a>, a <a href={`${base}calculators/macro-calculator/`}>macro calculator</a>, a <a href={`${base}calculators/protein-intake-calculator/`}>protein intake calculator</a>, a <a href={`${base}calculators/one-rep-max-calculator/`}>one rep max calculator</a>, a <a href={`${base}calculators/heart-rate-zone-calculator/`}>heart rate zone calculator</a>, a <a href={`${base}calculators/day-of-the-week-calculator/`}>day of the week calculator</a>, a <a href={`${base}calculators/week-number-calculator/`}>week number calculator</a>, and a <a href={`${base}calculators/btu-calculator/`}>BTU calculator</a>.</p></section>
