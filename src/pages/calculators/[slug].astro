---
import Layout from '../../layouts/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import { calculators } from '../../data/calculators.js';
import { calculatorContent } from '../../data/calculator-content.js';
import { absoluteSiteUrl } from '../../data/site.js';
import { clusterFor } from '../../data/clusters.js';

export function getStaticPaths() {
  return calculators.map((calculator) => ({ params: { slug: calculator.slug }, props: { calculator } }));
}

const { calculator } = Astro.props;
const content = calculatorContent[calculator.slug];
if (!content) throw new Error(`Missing page content for ${calculator.slug}`);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cluster = clusterFor(calculator.slug);
const related = (cluster
  ? calculators.filter((item) => cluster.members.includes(item.slug) && item.slug !== calculator.slug)
  : calculators.filter((item) => item.category === calculator.category && item.slug !== calculator.slug)
).slice(0, 6);
const canonical = absoluteSiteUrl(`/calculators/${calculator.slug}/`);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: content.h1,
      url: canonical,
      applicationCategory: 'CalculatorApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: content.description
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteSiteUrl(base) },
        { '@type': 'ListItem', position: 2, name: calculator.title, item: canonical }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: content.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a }
      }))
    }
  ]
};
const jsonLd = JSON.stringify(schema).replaceAll('<', '\\u003c');
---
<Layout title={content.title} description={content.description}>
  <script type="application/ld+json" set:html={jsonLd} />
  <section class="tool-hero">
    <a href={base}>← All calculators</a>
    <span class="category">{calculator.category}</span>
    <h1>{content.h1}</h1>
    <p>{content.description}</p>
  </section>
  <section class="tool-layout">
    <form class="calculator" data-slug={calculator.slug}>
      <div class="form-heading"><span class="calc-icon">{calculator.icon}</span><h2>Enter your details</h2></div>
      {calculator.fields.map(([name, label, type, value, suffix, fieldOptions]) => (
        <label>
          {label}
          <div class="input-wrap">
            {type === 'select' ? (
              <select name={name}>
                {(fieldOptions || calculator.options).map(([optionValue, optionLabel]) => <option value={optionValue} selected={String(optionValue) === String(value)}>{optionLabel}</option>)}
              </select>
            ) : (
              <input name={name} type={type} value={value} required={value !== ''} />
            )}
            {suffix && <span>{suffix}</span>}
          </div>
        </label>
      ))}
      <button class="button" type="submit">Calculate</button>
    </form>
    <aside class="result" aria-live="polite">
      <span class="eyebrow">YOUR RESULT</span>
      <strong id="result-headline">Enter values to begin</strong>
      <div id="result-details"><p>Your result and helpful details will appear here.</p></div>
    </aside>
  </section>
  <article class="article">
    {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    <h2>How to use this calculator</h2>
    <ol class="steps">{content.steps.map((step) => <li>{step}</li>)}</ol>
    <h2>{content.howHeading}</h2>
    {content.howItWorks.map((paragraph) => <p>{paragraph}</p>)}
    <h2>Formula</h2>
    <p class="formula">{content.formula}</p>
    {content.formulaNotes.map((paragraph) => <p>{paragraph}</p>)}
    <h2>{content.examplesHeading}</h2>
    {content.examples.map((example) => (
      <section class="example">
        <h3>{example.title}</h3>
        {example.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}
    <h2 id={content.table.anchor}>{content.table.heading}</h2>
    <div class="table-wrap">
      <table class="ref-table">
        <caption>{content.table.caption}</caption>
        <thead>
          <tr>{content.table.headers.map((header) => <th scope="col">{header}</th>)}</tr>
        </thead>
        <tbody>
          {content.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    {content.extraSections?.map((section) => (
      <section id={section.anchor}>
        <h2>{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.table ? (
          <>
            <h3>{section.table.heading}</h3>
            <div class="table-wrap">
              <table class="ref-table">
                <caption>{section.table.caption}</caption>
                <thead>
                  <tr>{section.table.headers.map((header) => <th scope="col">{header}</th>)}</tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
          </>
        ) : null}
      </section>
    ))}
    <h2>{content.limitsHeading}</h2>
    {content.limits.map((paragraph) => <p>{paragraph}</p>)}
    <h2>Frequently asked questions</h2>
    {content.faqs.map((faq) => (
      <section class="faq">
        <h3>{faq.q}</h3>
        <p>{faq.a}</p>
      </section>
    ))}
    {content.relatedLinks?.length ? (
      <>
        <h2>Related ClearCalc pages</h2>
        <ul class="missing-list">
          {content.relatedLinks.map((link) => (
            <li>
              <a href={`${base}calculators/${link.slug}/`}>{link.label}</a>
              {link.note ? ` ${link.note}` : ''}
            </li>
          ))}
        </ul>
      </>
    ) : null}
    <div class="notice"><strong>Important:</strong> {content.disclaimer}</div>
  </article>
  <section class="section">
    <h2>Related calculators</h2>
    {cluster ? <p class="category-note">More in <a href={`${base}topics/${cluster.id}/`}>{cluster.title}</a>.</p> : null}
    <div class="card-grid">{related.map((item) => <CalculatorCard item={item} />)}</div>
  </section>
  <script>
    import { calculate } from '../../lib/calculate.js';
    const form = document.querySelector('.calculator');
    const show = (values) => {
      try {
        const result = calculate(form.dataset.slug, values);
        document.querySelector('#result-headline').textContent = result.headline;
        document.querySelector('#result-details').innerHTML = result.details.map((line) => `<p>${line}</p>`).join('');
      } catch {
        document.querySelector('#result-headline').textContent = 'Please check your inputs';
      }
    };
    const params = new URLSearchParams(location.search);
    if (form?.dataset.slug === 'england-stamp-duty-calculator') {
      const price = params.get('price');
      const priceInput = form.querySelector('input[name="price"]');
      if (price && priceInput) {
        const cleaned = price.replace(/[£,\s]/g, '');
        if (/^\d+(\.\d+)?$/.test(cleaned)) priceInput.value = cleaned;
      }
      for (const name of ['buyer', 'residence', 'period']) {
        const value = params.get(name);
        const field = form.querySelector(`[name="${name}"]`);
        if (value && field) field.value = value;
      }
    }
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const values = Object.fromEntries(new FormData(form).entries());
      show(values);
      if (form.dataset.slug === 'england-stamp-duty-calculator') {
        const url = new URL(location.href);
        url.searchParams.set('price', values.price);
        history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
      }
    });
    if (form?.dataset.slug === 'england-stamp-duty-calculator' && params.get('price')) {
      show(Object.fromEntries(new FormData(form).entries()));
    }
  </script>
</Layout>
