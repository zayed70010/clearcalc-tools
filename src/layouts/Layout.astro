---
import '../styles/global.css';
const { title = 'ClearCalc Tools', description = 'Fast, free, and easy-to-use online calculators.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span>✓</span> ClearCalc</a>
      <nav aria-label="Main navigation"><a href="/#calculators">Calculators</a><a href="/about">About</a></nav>
    </header>
    <main><slot /></main>
    <footer><div><a class="brand footer-brand" href="/">ClearCalc Tools</a><p>Useful answers, without the clutter.</p></div><nav><a href="/about">About</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/contact">Contact</a></nav><small>© {new Date().getFullYear()} ClearCalc Tools</small></footer>
  </body>
</html>
