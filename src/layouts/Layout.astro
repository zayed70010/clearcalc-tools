---
import '../styles/global.css';
import { absoluteSiteUrl } from '../data/site.js';
const { title = 'ClearCalc Tools', description = 'Fast, free, and easy-to-use online calculators.', robots, canonical: canonicalOverride } = Astro.props;
const canonical = canonicalOverride === false ? null : absoluteSiteUrl(Astro.url.pathname);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const socialImage = absoluteSiteUrl('/og-image.png');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#13251f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ClearCalc Tools" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}><span>✓</span> ClearCalc</a>
      <nav aria-label="Main navigation"><a href={`${base}#calculators`}>Calculators</a><a href={`${base}about/`}>About</a></nav>
    </header>
    <main><slot /></main>
    <footer><div><a class="brand footer-brand" href={base}>ClearCalc Tools</a><p>Useful answers, without the clutter.</p></div><nav aria-label="Footer"><a href={`${base}about/`}>About</a><a href={`${base}contact/`}>Contact</a><a href={`${base}privacy-policy/`}>Privacy Policy</a><a href={`${base}terms/`}>Terms</a><button type="button" class="analytics-choice" id="analytics-choices" aria-controls="analytics-consent" aria-expanded="false">Analytics choices</button></nav><small>© {new Date().getFullYear()} ClearCalc Tools</small></footer>
    <div id="analytics-consent" class="analytics-consent" role="dialog" aria-modal="false" aria-labelledby="analytics-consent-title" aria-describedby="analytics-consent-copy" hidden>
      <div class="analytics-consent-copy">
        <h2 id="analytics-consent-title">Analytics choice</h2>
        <p id="analytics-consent-copy">ClearCalc can count pages, engagement, and referral sources with Google Analytics. It stays off until you accept. Numbers you type into a calculator are not sent. You can change this choice at any time. <a href="/privacy-policy/">Privacy policy</a></p>
      </div>
      <div class="analytics-consent-actions">
        <button type="button" class="analytics-reject" id="analytics-reject">Reject analytics</button>
        <button type="button" class="analytics-accept" id="analytics-accept">Accept analytics</button>
      </div>
    </div>
    <p id="analytics-consent-status" class="visually-hidden" aria-live="polite"></p>
    <script>
      import { bootAnalyticsConsent } from '../lib/analytics-consent.js';
      bootAnalyticsConsent();
    </script>
  </body>
</html>
