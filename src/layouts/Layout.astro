---
import '../styles/global.css';
const { title = 'ClearCalc Tools', description = 'Fast, free, and easy-to-use online calculators.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}><span>✓</span> ClearCalc</a>
      <nav aria-label="Main navigation"><a href={`${base}#calculators`}>Calculators</a><a href={`${base}about/`}>About</a></nav>
    </header>
    <main><slot /></main>
    <footer><div><a class="brand footer-brand" href={base}>ClearCalc Tools</a><p>Useful answers, without the clutter.</p></div><nav><a href={`${base}about/`}>About</a><a href={`${base}privacy/`}>Privacy</a><a href={`${base}terms/`}>Terms</a><a href={`${base}contact/`}>Contact</a></nav><small>© {new Date().getFullYear()} ClearCalc Tools</small></footer>
  </body>
</html>
