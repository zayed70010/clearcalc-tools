---
const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="calc-card" href={`${base}calculators/${item.slug}/`}>
  <span class="calc-icon">{item.icon}</span><span class="category">{item.category}</span>
  <h3>{item.title}</h3><p>{item.description}</p><strong>Open calculator →</strong>
</a>
